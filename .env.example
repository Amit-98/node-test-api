# ==========================================
# 1. SERVER CONFIGURATION
# ==========================================
PORT=3000

# ==========================================
# 2. DATABASE SELECTION
# ==========================================
# Options: mysql | mongodb
DB_TYPE=mysql

# Options: local | development | production
DB_KEY=local

# ==========================================
# 3. MYSQL CONFIGURATION
# ==========================================
# Local MySQL
MYSQL_LOCAL_HOST=localhost
MYSQL_LOCAL_USER=root
MYSQL_LOCAL_PASSWORD=your_local_password
MYSQL_LOCAL_DATABASE=your_local_db
MYSQL_LOCAL_PORT=3306

# Development MySQL
MYSQL_DEV_HOST=localhost
MYSQL_DEV_USER=root
MYSQL_DEV_PASSWORD=your_dev_password
MYSQL_DEV_DATABASE=your_dev_db
MYSQL_DEV_PORT=3306

# Production MySQL
MYSQL_PROD_HOST=your_prod_host
MYSQL_PROD_USER=your_prod_user
MYSQL_PROD_PASSWORD=your_prod_password
MYSQL_PROD_DATABASE=your_prod_db
MYSQL_PROD_PORT=3306

# ==========================================
# 4. MONGODB CONFIGURATION
# ==========================================
# Local MongoDB
MONGODB_LOCAL_URI=mongodb://localhost:27017/blog
MONGODB_LOCAL_DBNAME=blog

# Development MongoDB
MONGODB_DEV_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/blog
MONGODB_DEV_DBNAME=blog

# Production MongoDB
MONGODB_PROD_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/blog
MONGODB_PROD_DBNAME=blog

# ==========================================
# 5. EMAIL CONFIGURATION (NODEMAILER)
# ==========================================
EMAIL_HOST_USER=sigmaplextech@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_gmail_app_password
ADMIN_EMAIL=sigmaplextech@gmail.com
EMAIL_SERVICE=gmail
EMAIL_PORT=587